{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIToBackendInferenceEvent",
  "description": "Schema for AI detection and ANPR worker output sent to Kafka / Backend",
  "type": "object",
  "required": [
    "event_id",
    "camera_id",
    "timestamp",
    "frame_id",
    "detections"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "camera_id": {
      "type": "string",
      "example": "CAM_SECTOR_17_01"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "frame_id": {
      "type": "integer",
      "minimum": 0
    },
    "camera_gps": {
      "type": "object",
      "properties": {
        "lat": { "type": "number" },
        "lng": { "type": "number" }
      }
    },
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["track_id", "vehicle_class", "bbox", "confidence"],
        "properties": {
          "track_id": { "type": "integer" },
          "vehicle_class": {
            "type": "string",
            "enum": ["car", "motorcycle", "scooter", "bus", "truck", "van", "auto-rickshaw", "pedestrian"]
          },
          "bbox": {
            "type": "object",
            "description": "Normalized bounding box [0.0 - 1.0]",
            "required": ["x_min", "y_min", "x_max", "y_max"],
            "properties": {
              "x_min": { "type": "number" },
              "y_min": { "type": "number" },
              "x_max": { "type": "number" },
              "y_max": { "type": "number" }
            }
          },
          "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "attributes": {
            "type": "object",
            "properties": {
              "color": { "type": "string" },
              "make": { "type": "string" },
              "model": { "type": "string" },
              "helmet_detected": { "type": "boolean" },
              "seatbelt_detected": { "type": "boolean" }
            }
          },
          "speed_kmh": { "type": "number" },
          "direction_deg": { "type": "number" },
          "plate": {
            "type": "object",
            "properties": {
              "plate_number": { "type": "string", "example": "CH01AB1234" },
              "plate_bbox": {
                "type": "object",
                "properties": {
                  "x_min": { "type": "number" },
                  "y_min": { "type": "number" },
                  "x_max": { "type": "number" },
                  "y_max": { "type": "number" }
                }
              },
              "ocr_confidence": { "type": "number" },
              "state_code": { "type": "string" },
              "plate_crop_url": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
